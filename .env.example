# M3ta-0S Dashboard — environment variables
# Copy to .env.local and fill in. Never commit secrets.

# ---- Obsidian ----
# Absolute path to your local Obsidian vault. When set, the Obsidian adapter
# will compute real read-only stats (note count, recent files, tags).
# Leave unset to use the deterministic mock adapter.
OBSIDIAN_VAULT_PATH=

# ---- Hermes ----
# Optional Hermes orchestrator URL. If unset, the dashboard uses the in-memory
# mock orchestrator that ships with this repo.
HERMES_URL=
HERMES_API_KEY=

# ---- Aion ----
# Optional override for Aion timeline source. If unset, in-memory mocks
# provide deterministic scheduled automations and event stream.
AION_URL=

# ---- Paperclip ----
# Directory where Paperclip captures are persisted as JSONL. If unset,
# captures are kept in process memory only and are lost on restart.
PAPERCLIP_STORE=

# ---- Claude Code ----
# Path to the workspace Claude Code should report on. Defaults to the
# current working directory of the Next.js process.
CLAUDE_CODE_WORKSPACE=

# ---- Feature flags ----
# Set to 1 to require the user to approve any "act" buttons in the UI.
M3TA_REQUIRE_APPROVALS=1
