# =============================================================================
# M3ta-0S UI-TARS Integration - Environment Configuration Example
# =============================================================================
# Copy to .env and fill values. Do NOT commit .env.
# All values are read by m3ta_uitars.config.Settings (pydantic).

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Provider: "local_uitars" | "remote_operator" | "mock"
M3TA_UITARS_PROVIDER=mock

# "macos_local" | "docker_server" | "hybrid"
M3TA_UITARS_RUNTIME=hybrid

# Logging level
M3TA_UITARS_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# HTTP server (n8n / OpenClaw webhook surface)
# -----------------------------------------------------------------------------
M3TA_UITARS_HTTP_HOST=127.0.0.1
M3TA_UITARS_HTTP_PORT=8765

# Shared secret for webhook auth. Required in production.
# Callers send: Authorization: Bearer <token>  OR  X-M3TA-Token: <token>
M3TA_UITARS_API_TOKEN=

# CORS origins (comma-separated). Empty = disabled.
M3TA_UITARS_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Local UI-TARS Desktop provider (placeholder bridge)
# -----------------------------------------------------------------------------
# URL of a local UI-TARS Desktop bridge if/when one is implemented.
M3TA_UITARS_LOCAL_BRIDGE_URL=http://127.0.0.1:9001
M3TA_UITARS_LOCAL_BRIDGE_TOKEN=

# -----------------------------------------------------------------------------
# Remote operator provider (browser/computer-use, Doubao, HF UI-TARS-1.5, etc.)
# -----------------------------------------------------------------------------
M3TA_UITARS_REMOTE_BASE_URL=
M3TA_UITARS_REMOTE_API_KEY=
M3TA_UITARS_REMOTE_MODEL=ui-tars-1.5

# -----------------------------------------------------------------------------
# Safety / governance
# -----------------------------------------------------------------------------
# Default to dry-run unless caller explicitly opts in.
M3TA_UITARS_DEFAULT_DRY_RUN=true

# Comma-separated allowlist of action types that are always allowed.
# Available action types: observe, click, type, key, scroll, wait, navigate, screenshot
M3TA_UITARS_ACTION_ALLOWLIST=observe,screenshot,wait

# Action types that require explicit confirmation_token in the request.
M3TA_UITARS_CONFIRM_REQUIRED=navigate,type,click,key,scroll

# Comma-separated allowlist of target hosts the agent may navigate to.
# Empty list means "allow none" when M3TA_UITARS_ENFORCE_HOST_ALLOWLIST=true.
M3TA_UITARS_HOST_ALLOWLIST=
M3TA_UITARS_ENFORCE_HOST_ALLOWLIST=true

# Audit log directory. JSONL files written per task.
M3TA_UITARS_AUDIT_DIR=./.audit

# Persist screenshots to audit dir (true|false).
M3TA_UITARS_AUDIT_SCREENSHOTS=true

# Maximum task wall-clock seconds before auto-cancel.
M3TA_UITARS_TASK_TIMEOUT_SECONDS=300
